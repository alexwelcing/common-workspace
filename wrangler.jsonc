{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commonwork",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMON_ROOMS",
        "class_name": "CommonRoom"
      },
      {
        "name": "COMMON_ADMISSION",
        "class_name": "CommonAdmission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CommonRoom",
        "CommonAdmission"
      ]
    }
  ],
  "version_metadata": {
    "binding": "COMMON_VERSION"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 1000
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "COMMON_ROOMS",
          "class_name": "CommonRoom"
        },
        {
          "name": "COMMON_ADMISSION",
          "class_name": "CommonAdmission"
        }
      ]
    },
    "version_metadata": {
      "binding": "COMMON_VERSION"
    }
  }
}
