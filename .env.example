# Optional local environment: Bun loads .env automatically.
# Hosted backend settings should be configured through your hosting provider.
HOST=0.0.0.0
PORT=3001

# Private mode makes no default public STUN or PlantUML requests.
# `bun run local` selects private mode unless you explicitly choose otherwise.
# Standard mode enables the documented public defaults.
COMMON_NETWORK_PROFILE=private
# STUN_URLS=stun:stun.your-organization.example:3478
# STUN_URLS=none
# PLANTUML_URL=https://diagrams.your-organization.example/plantuml
# PLANTUML_URL=none
# Set relay only when TURN is configured and direct connections should be avoided.
# ICE_TRANSPORT_POLICY=relay
# Optional redacted request logs / OTLP traces; configured on the server only.
# COMMON_LOG_DIAGNOSTICS=1
# COMMON_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# COMMON_OTLP_TOKEN=collector-authorization-token

# When using public/self-hosting/Caddyfile on this same laptop, set HOST to
# 127.0.0.1 so only the HTTPS proxy is exposed to teammates. Keep 0.0.0.0 inside
# Docker when another container/reverse proxy needs to reach this process.
# Build with `bun run build:local` for the standalone WebSocket transport.

# Default is ./data/rooms.json beside server.mjs.
# Docker sets this to /data/rooms.json; mount a persistent volume at /data.
# DATA_FILE=/absolute/path/to/persistent/rooms.json

# Same-host requests work without an allowlist. No trailing slashes or spaces.
# ALLOWED_ORIGINS=https://common.example.com

# TURN relay, served only to authenticated room participants.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Preferred: shared secret matching coturn's static-auth-secret with use-auth-secret.
# Browser credentials expire after one hour; the shared secret stays on the server.
# TURN_SECRET=replace-with-a-long-random-secret
# TURN_TTL_SECONDS=3600
# Alternative: a dedicated static relay account (omit TURN_SECRET).
# TURN_USERNAME=common-relay
# TURN_CREDENTIAL=replace-with-a-dedicated-relay-credential
