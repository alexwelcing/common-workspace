        "readOnlyHint": false,
        "untrustedContentHint": true,
        "consequentialHint": false
      }
    },
    {
      "name": "common_recording_stop",
      "action": "recording.stop",
      "description": "Stop the local recording.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Optional idempotency key within this permission grant and canvas session."
          }
        }
      },
      "capabilities": [
        "recording"
      ],
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": true,
        "consequentialHint": false
      }
    },
    {
      "name": "common_recording_list",
      "action": "recording.list",
      "description": "List locally retained recording metadata.",
      "inputSchema": {
        "type": "object",
